root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.jsonc]
indent_size = 2

[*.xml]
indent_size = 2

[*.conf]
indent_size = 2

[*.cmd]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.bat]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.sh]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.reg]
end_of_line = crlf
indent_style = space
indent_size = 4
