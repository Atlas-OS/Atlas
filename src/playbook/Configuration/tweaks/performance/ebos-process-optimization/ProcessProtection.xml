        <Telemetry>
            DiagTrack,dmwappushservice,diagnosticshub.standardcollector.service,
            DPS,WdiServiceHost,WdiSystemHost,Wecsvc,WEPHOSTSVC
        </Telemetry>
    </OptimizationTargets>
    
    <Rollback>
        <Enabled>true</Enabled>
        <AutoBackup>true</AutoBackup>
        <BackupLocation>%PROGRAMDATA%\ProcessOptimization\Backup</BackupLocation>
        <RestoreScript>Rollback_Script.ps1</RestoreScript>
    </Rollback>
</ProcessOptimization>
