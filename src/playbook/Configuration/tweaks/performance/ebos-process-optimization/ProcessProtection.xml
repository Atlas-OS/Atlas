<ProcessOptimization>
    <Version>3.1.0</Version>
    <TargetProcessCount>40</TargetProcessCount>
    <ProtectionList>
        <!-- Category A: Kernel & Session (1-6) -->
        <Process name="System Idle Process" priority="1" category="Kernel" ServiceGroup=""/>
        <Process name="System" priority="2" category="Kernel" ServiceGroup=""/>
        <Process name="Registry" priority="3" category="Kernel" ServiceGroup=""/>
        <Process name="smss.exe" path="\Windows\System32\smss.exe" priority="4" category="Session" ServiceGroup=""/>
        <Process name="csrss.exe" path="\Windows\System32\csrss.exe" priority="5" category="Session" ServiceGroup=""/>
        <Process name="wininit.exe" path="\Windows\System32\wininit.exe" priority="6" category="Session" ServiceGroup=""/>
        
        <!-- Category B: Security (7-13) -->
        <Process name="services.exe" path="\Windows\System32\services.exe" priority="7" category="Security" ServiceGroup=""/>
        <Process name="lsass.exe" path="\Windows\System32\lsass.exe" priority="8" category="Security" ServiceGroup=""/>
        <Process name="winlogon.exe" path="\Windows\System32\winlogon.exe" priority="9" category="Security" ServiceGroup=""/>
        <Process name="LsaIso.exe" path="\Windows\System32\LsaIso.exe" priority="10" category="Security" ServiceGroup=""/>
        <Process name="svchost.exe" serviceGroup="RpcSs" priority="11" category="Core Services" ServiceGroup="RpcSs"/>
        <Process name="svchost.exe" serviceGroup="DcomLaunch" priority="12" category="Core Services" ServiceGroup="DcomLaunch"/>
        <Process name="svchost.exe" serviceGroup="Power" priority="13" category="Core Services" ServiceGroup="Power"/>
        
        <!-- Category C: UI & Shell (14-20) -->
        <Process name="dwm.exe" path="\Windows\System32\dwm.exe" priority="14" category="UI" ServiceGroup=""/>
        <Process name="explorer.exe" path="\Windows\explorer.exe" priority="15" category="UI" ServiceGroup=""/>
        <Process name="sihost.exe" path="\Windows\System32\sihost.exe" priority="16" category="UI" ServiceGroup=""/>
        <Process name="fontdrvhost.exe" path="\Windows\System32\fontdrvhost.exe" priority="17" category="UI" ServiceGroup=""/>
        <Process name="ctfmon.exe" path="\Windows\System32\ctfmon.exe" priority="18" category="UI" ServiceGroup=""/>
        <Process name="taskhostw.exe" path="\Windows\System32\taskhostw.exe" priority="19" category="UI" ServiceGroup=""/>
        <Process name="RuntimeBroker.exe" path="\Windows\System32\RuntimeBroker.exe" priority="20" category="UI" ServiceGroup=""/>
        
        <!-- Category D: Audio & Network (21-28) -->
        <Process name="audiodg.exe" path="\Windows\System32\audiodg.exe" priority="21" category="Audio" ServiceGroup=""/>
        <Process name="svchost.exe" serviceGroup="AudioSrv" priority="22" category="Audio" ServiceGroup="AudioSrv"/>
        <Process name="svchost.exe" serviceGroup="Dhcp" priority="23" category="Network" ServiceGroup="Dhcp"/>
        <Process name="svchost.exe" serviceGroup="Dnscache" priority="24" category="Network" ServiceGroup="Dnscache"/>
        <Process name="svchost.exe" serviceGroup="NLA" priority="25" category="Network" ServiceGroup="NLA"/>
        <Process name="svchost.exe" serviceGroup="nsi" priority="26" category="Network" ServiceGroup="nsi"/>
        <Process name="svchost.exe" serviceGroup="mpssvc" priority="27" category="Network" ServiceGroup="mpssvc"/>
        <Process name="spoolsv.exe" path="\Windows\System32\spoolsv.exe" priority="28" category="Print" ServiceGroup=""/>
        
        <!-- Category E: GPU & Hardware (29-35) -->
        <Process name="nvcontainer.exe" priority="29" category="GPU" ServiceGroup=""/>
        <Process name="amdow.exe" priority="29" category="GPU" ServiceGroup=""/>
        <Process name="igfxCUIService.exe" priority="29" category="GPU" ServiceGroup=""/>
        <Process name="conhost.exe" path="\Windows\System32\conhost.exe" priority="30" category="Console" ServiceGroup=""/>
        <Process name="wlanext.exe" path="\Windows\System32\wlanext.exe" priority="31" category="WiFi" ServiceGroup=""/>
        <Process name="svchost.exe" serviceGroup="CryptSvc" priority="32" category="Security" ServiceGroup="CryptSvc"/>
        <Process name="svchost.exe" serviceGroup="ProfSvc" priority="33" category="User" ServiceGroup="ProfSvc"/>
        <Process name="svchost.exe" serviceGroup="gpsvc" priority="34" category="Policy" ServiceGroup="gpsvc"/>
        <Process name="svchost.exe" serviceGroup="EventLog" priority="35" category="Logging" ServiceGroup="EventLog"/>
    </ProtectionList>
    
    <OptimizationTargets>
        <Services>
            DiagTrack,dmwappushservice,diagnosticshub.standardcollector.service,DPS,WdiServiceHost,WdiSystemHost,
            Wecsvc,WEPHOSTSVC,MapsBroker,lfsvc,EdgeUpdate,edgeupdatem,wuauserv,UsoSvc,WaaSMedicSvc,BITS,DoSvc,
