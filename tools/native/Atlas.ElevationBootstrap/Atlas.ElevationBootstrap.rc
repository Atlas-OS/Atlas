            VALUE "CompanyName", "AtlasOS\0"
            VALUE "FileDescription", "Atlas trusted elevation transport bootstrap\0"
            VALUE "FileVersion", "0.6.0.0\0"
            VALUE "InternalName", "Atlas.ElevationBootstrap\0"
