            VALUE "OriginalFilename", "Atlas.ElevationBootstrap.exe\0"
            VALUE "ProductName", "AtlasOS\0"
            VALUE "ProductVersion", "0.6.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
