# Line ending normalization
*.ps1  eol=lf
*.psm1 eol=lf
*.psd1 eol=lf
*.yml  eol=lf
*.yaml eol=lf
*.bat  eol=crlf
*.cmd  eol=crlf
# Registry Editor 5.00 payloads are UTF-16LE. Git's byte-oriented EOL filters
# corrupt their two-byte code units, so preserve registry payload bytes exactly.
*.reg  -text
*.sh   eol=lf

# Binary files
*.apbx binary
*.cab  binary
*.zip  binary
*.dll  binary
*.exe  binary
*.png  binary
*.ico  binary
*.lnk  binary
