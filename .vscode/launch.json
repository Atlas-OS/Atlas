{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "PowerShell",
      "request": "launch",
      "name": "Build Atlas package (Test)",
      "script": "& \"$(Join-Path '${workspaceFolder}' 'tools/build/Build-Playbook.ps1')\" -LocalTest",
      "cwd": "${workspaceFolder}/playbook",
      "args": []
    },
    {
      "type": "PowerShell",
      "request": "launch",
      "name": "Build Atlas package (Test w/o requirement gates)",
      "script": "& \"$(Join-Path '${workspaceFolder}' 'tools/build/Build-Playbook.ps1')\" -LocalTest -Removals Requirements",
      "cwd": "${workspaceFolder}/playbook",
      "args": []
    },
    {
      "type": "PowerShell",
      "request": "launch",
      "name": "Build Atlas package (Release)",
      "script": "& \"$(Join-Path '${workspaceFolder}' 'tools/build/Build-Playbook.ps1')\" -FileName 'Atlas Release'",
      "cwd": "${workspaceFolder}/playbook",
      "args": []
    },
    {
      "type": "PowerShell",
      "request": "launch",
      "name": "Build Atlas package (Release Candidate)",
      "script": "& \"$(Join-Path '${workspaceFolder}' 'tools/build/Build-Playbook.ps1')\" -FileName 'Atlas RC' -ReplaceOldPlaybook -Removals Verification",
      "cwd": "${workspaceFolder}/playbook",
      "args": []
    }
  ]
}
